    {
      "rule_id": "exercise_66_false_trendline_break",
      "name": "趋势线短暂刺穿不得直接改判",
      "applies_to": ["trendline_break"],
      "required_evidence": {"days_below_trendline": {"lt": 3}},
      "context_filters": {},
      "state_machine": {
        "initial": "detected",
        "transitions": [
          {"from": "detected", "to": "candidate", "when": {"days_below_trendline": {"lt": 3}}},
          {"from": "candidate", "to": "invalidated", "when": {"reclaim_trendline": {"eq": true}}},
          {"from": "candidate", "to": "confirmed", "when": {"days_below_trendline": {"gte": 3}}}
        ]
      },
      "priority": 86,
      "resolution": {
        "winner": "uptrend",
        "loser": "trendline_break",
        "output_state": "candidate",
        "confidence_adjustment": 0.18,
        "suppression_reason": "持续时间和偏离幅度的确认优先于单日穿越"
      },
      "invalidation": {
        "conditions": [{"field": "days_below_trendline", "operator": "gte", "value": 3}],
        "confirmation_days": 3,
        "description": "持续在线外且偏离达到max(3%,1ATR)后，原趋势完整性判断失效"
      },
      "source": "《股市操练大全习题集》习题66（用户已结构化复核）",
      "version": "1.0"
    },
