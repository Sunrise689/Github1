.chart-shell {
  position: relative;
  width: 100%;
  height: 600rpx;
  overflow: hidden;
  border: 1rpx solid #e4e8ef;
  border-radius: 12rpx;
  background: #fbfcfd;
  box-shadow: 0 8rpx 24rpx rgba(19, 23, 34, 0.035);
}

.chart-scroll,
.chart-content {
  height: 600rpx;
}

.chart-scroll {
  width: 100%;
  white-space: nowrap;
}

.chart-content {
  position: relative;
  min-width: 100%;
}

.chart-canvas {
  display: block;
  height: 600rpx;
}

.chart-tip {
  position: absolute;
  top: 16rpx;
  left: 18rpx;
  right: 18rpx;
  display: flex;
  gap: 16rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid #edf0f4;
  background: rgba(255, 255, 255, 0.96);
  color: #5d606b;
  font-size: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(24, 32, 27, 0.08);
}

.empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #787b86;
}
