page { background: #f7f8fb; color: #131722; }
.contact-page { min-height: 100vh; padding: 30rpx 26rpx 70rpx; box-sizing: border-box; }
.contact-hero, .contact-card, .email-button { border: 1rpx solid #e2e6ee; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(19, 23, 34, .045); }
.contact-hero { padding: 32rpx 28rpx; background: linear-gradient(145deg, #fff, #f0f4ff); }
.eyebrow, .card-kicker { display: block; color: #2962ff; font-size: 19rpx; font-weight: 750; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 12rpx; color: #151821; font-size: 42rpx; line-height: 1.25; font-weight: 800; }
.page-copy, .card-copy, .contact-note { display: block; color: #777d89; font-size: 22rpx; line-height: 1.7; }
.page-copy { margin-top: 14rpx; }
.contact-card { margin-top: 18rpx; padding: 26rpx 28rpx; }
.card-title { display: block; margin-top: 9rpx; color: #272d3a; font-size: 28rpx; line-height: 1.4; font-weight: 750; }
.card-copy { margin-top: 13rpx; }
.email-button { display: flex; flex-direction: column; align-items: flex-start; width: 100%; margin: 18rpx 0 0; padding: 26rpx 28rpx; box-sizing: border-box; text-align: left; }
.email-button::after { border: 0; }
.email-label { color: #8c929e; font-size: 20rpx; }
.email-value { margin-top: 8rpx; color: #2962ff; font-size: 30rpx; font-weight: 750; }
.email-action { margin-top: 10rpx; color: #8c929e; font-size: 19rpx; }
.contact-note { padding: 22rpx 8rpx 0; color: #a0a3ac; font-size: 19rpx; text-align: center; }
