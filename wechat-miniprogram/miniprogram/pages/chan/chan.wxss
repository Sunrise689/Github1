@import "../../styles/tool-page.wxss";

.chan-canvas { width: 100%; height: 430rpx; }
.chan-legend { display: flex; gap: 20rpx; margin-top: 10rpx; flex-wrap: wrap; color: #777b85; font-size: 19rpx; }
.chan-legend-item { display: flex; align-items: center; gap: 8rpx; }
.chan-stroke { width: 30rpx; height: 4rpx; border-radius: 4rpx; background: #20242d; }
.chan-center { width: 28rpx; height: 16rpx; border: 2rpx solid #2962ff; background: rgba(41,98,255,.08); }
.chan-buy, .chan-sell { width: 13rpx; height: 13rpx; border-radius: 50%; }
.chan-buy { background: #f23645; }
.chan-sell { background: #089981; }
.method-flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; margin-top: 20rpx; }
.method-step { padding: 17rpx 8rpx; border: 1rpx solid #e7e9ef; border-radius: 14rpx; background: #fafbfe; text-align: center; }
.method-index { display: block; color: #2962ff; font-size: 18rpx; font-weight: 750; }
.method-name { display: block; margin-top: 5rpx; font-size: 21rpx; font-weight: 700; }
.source-card { margin-top: 18rpx; padding: 22rpx; border-left: 4rpx solid #2962ff; border-radius: 4rpx 16rpx 16rpx 4rpx; color: #616570; background: #f5f7fb; font-size: 22rpx; line-height: 1.7; }
